# Local development only — copy to `.env` if you publish from your machine.
# CI/CD does NOT use this file; GitHub Actions uses repository secrets instead.

# npm Automation token (Publish) from https://www.npmjs.com/settings/~your-user/tokens
# Required only for: npm publish / npx semantic-release (local)
# NPM_TOKEN=npm_xxxxxxxxxxxxxxxx

# Optional dry-run (local)
# DRY_RUN=true
